# Copy this file to .env.local and fill in YOUR values.
# .env.local is git-ignored. Never commit it, never paste its contents in chat.
#
# Supabase dashboard -> Project Settings -> API (or "API Keys")

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). The legacy "anon" key also works.
# These two are SAFE for the browser because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of this site (used in email links). Local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: the service-role / secret key is intentionally NOT used by this app.
# Do not add it here. If a future feature needs it, it must stay server-only.
